# macOS Finder metadata
.DS_Store

# Files generated by invoking Julia with --code-coverage
*.jl.cov
*.jl.*.cov

# Files generated by invoking Julia with --track-allocation
*.jl.mem

# System-specific files and directories generated by the BinaryProvider and BinDeps packages
deps/deps.jl
deps/build.log
deps/downloads/
deps/usr/
deps/src/

# File generated by Pkg, the package manager, based on a corresponding Project.toml
Manifest.toml

# Private prediction output (local only, not committed)
prediction_docs/

# The rendered race reports site is build output, deployed to Netlify straight
# from disk by scripts/deploy_site.sh. It used to be committed because GitHub
# Pages could only publish what was in the repo, which put a push on the
# critical path of every race and churned megabytes of generated HTML.
# Regenerate it with scripts/render_reports.jl (--force for a full rebuild);
# that needs DEFAULT_ARCHIVE_DIR, which a clone alone never had.
site/docs/

# Netlify credentials for scripts/deploy_site.sh (see .env.example)
.env

# LLM permissions
.claude/settings.local.json

# Local environment (direnv)
.envrc

# manual odds
*.txt

# Per-race notebook config (changes every race, not version controlled)
data/race_config.toml
data/race_config.toml.*
!data/race_config.toml.example

# Full league standings: every entrant's real name and score. Not published
# anywhere (the site shows winning team names only), so it stays local.
data/league_standings.toml

/.quarto/

# Local refactor plan (working notes, not version controlled)
REFACTOR_PLAN.md

# Netlify CLI scratch state (contains an absolute publish path)
.netlify/
docs/two-package-reconciliation.md

# Publish lock: scripts/auto_publish.sh takes an mkdir lock in the repo root
.velogames-publish.lock/
