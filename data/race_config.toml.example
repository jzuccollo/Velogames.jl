# Race configuration — shared between render scripts (predictor, stagerace, assessor)
# Copy to race_config.toml and edit for each race. race_config.toml is gitignored.
#
# Within [data_sources] and [optimisation], keys are grouped by renderer:
#   shared      — used by all renderers
#   one-day     — used by render_predictor.jl only
#   stage races — used by render_stagerace.jl only

[race]
name = "e3-harelbeke"        # PCS slug or alias ("tdf", "giro", "vuelta")
year = 2026
racehash = "#E3SaxoClassic"  # VG startlist hash filter (empty = all riders)

[output]
dir = "prediction_docs"      # HTML output directory (relative to project root)

[data_sources]
# --- shared (GC / overall winner) ---
oracle_url = ""              # Cycling Oracle GC prediction URL
use_oddschecker = true       # Parse oddschecker_paste.txt from project root

# --- one-day only ---

# --- stage races only ---
points_oracle_url        = "" # Cycling Oracle points-jersey URL (routes to flat/hilly dimensions)
kom_oracle_url           = "" # Cycling Oracle KOM URL (routes to mountain dimension)
points_odds_paste_file   = "" # Bookmaker points-jersey paste filename (relative to project root)
kom_odds_paste_file      = "" # Bookmaker KOM paste filename
stagewin_odds_paste_file = "" # Bookmaker "Rider To Win A Stage" paste filename
# VG slugs for other rounds of the same season-long series. Stage races only —
# `solve_oneday` ignores this. Only consulted when this game's own `points`
# column is all zeros (the single-race Femmes/GT format), in which case the VG
# season-points signal is filled with each rider's mean points per round across
# these games. Example, 2026 Womens Championship:
#   season_round_slugs = ["spain-femenina", "italy-women", "suisse-women",
#                         "burgos-feminas", "itzulia-women"]
season_round_slugs = []

[optimisation]
# --- shared ---
n_resamples = 500            # Resampled optimisation iterations (more = smoother, slower)
history_years = 3            # Years of PCS race history to fetch
domestique_discount = 1.0    # Penalise non-leaders proportionally to strength gap (0 = off)
risk_aversion = 0.5          # Penalise volatile riders via downside CV (0 = off)
max_per_team = 2             # Diversification cap, not a game rule: max riders from any
                             # single team (0 = no limit). Same for both formats; the
                             # backtest harness defaults to 2 so its metric matches.
simulation_df = 5            # Student's t degrees of freedom ("" = Gaussian)
excluded_riders = []

# --- one-day races only ---
# Weight on the simulator when blending its (risk-adjusted, unit-normalised) EVG
# with the bookmaker's unit-normalised implied win probabilities before the final
# team pick. 1.0 = pure simulator (no blend); lower leans harder on the market.
# 0.5 is the shipped default; 0.25 scored identically on the 2026 evidence, so go
# lower only on races where you trust the book more. No effect without odds.
market_blend_weight = 0.5

# --- stage races only ---
n_alternatives = 20          # Near-optimal teams to enumerate (k-best) for the team switcher / filler pool / structural forks
cross_stage_alpha = 0.7      # Cross-stage noise correlation (0 = independent, 1 = identical)
pcs_stage_scrape = true      # Scrape stage profiles from PCS (false = use manual stages)
gt_vg_history = true         # Option A (on by default): inject each rider's own prior GT VG totals as a role/propensity strength signal (see roadmap.md)
gt_vg_propensity = true      # Option B (on by default): two-sided EVG correction from the residual of real prior GT totals vs ability-implied EVG (see roadmap.md)
gt_vg_propensity_mode = "posthoc"  # Option B injection point: "posthoc" (scale the EVG mean) or "sim" (scale every simulation draw)

[team_assessor]
vg_race_number = 0           # 0 = auto-detect, -1 = skip, or set manually (e.g. 3)
# Pull the entered team from the archived [league] rosters rather than my_team.
# Velogames only publishes rosters after the entry deadline, so this finds
# nothing before the race and my_team is used instead (with a warning).
use_league_team = false
my_team = [
    "Mathieu Van Der Poel",
    "Mads Pedersen"
]

[league]
# Which league you play in. Read from the archive (league/rosters, league/meta,
# league/winners) by league_eval.jl and the team assessor — no scraper is
# duplicated here.
#
# vgleague_data_dir is used by scripts/ingest_league.jl alone, which is the one
# thing in this package that reads the vgleague repo; everything else reads the
# archive. Point it at the *deploy* clone: since July 2026 scraping runs from a
# launchd job against ~/code/vgleague-deploy (Velogames' Cloudflare blocks
# GitHub Actions runner IPs), so ~/code/vgleague is a dev clone whose data
# directory is stale and will silently yield mid-season standings.
vgleague_data_dir = "~/code/vgleague-deploy/data"
game_slug = "sixes-classics"
year = 2026
league_id = "100737112"
user_name = "JZ"             # vgleague username whose entered team is scored (not the display team name)

[entered_team]
# Manual override for the team actually entered in the CURRENT race
# ([race] above), only needed if it isn't in the archived rosters yet.
# league_eval.jl prefers this over the archive when both are present.
riders = []
score = 0                    # 0 = compute from riders + archived VG results when the race is scored
